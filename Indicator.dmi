
//@version=6
indicator("Moving ADX DMI",overlay = true)

ma_period = input.int(50,"MA MA eriod")
dmi_period = input.int(50,"DMI Period")
adx_smoothing  = input.int(14,"ADX Smoothing")
adx_trend_level = input.int(20,"ADX Trend Level")

[Di,di,adx] = ta.dmi(dmi_period,adx_smoothing )
ma = ta.wma(close,ma_period)

trend_up = adx > adx_trend_level and Di > di and ma >ma[1]
trend_down = adx > adx_trend_level and Di < di and ma < ma[1]

macolor = trend_up ? color.blue : trend_down ? color.red : color.yellow

plot(ma,"MA",macolor,3)
